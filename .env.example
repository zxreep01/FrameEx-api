# Server port (Render sets PORT automatically)
PORT=8000

# Resource & concurrency tuning (optimized for Render 512 MB Free / Starter instances)
MAX_CONCURRENT_JOBS=2
FFMPEG_THREADS=2
FFMPEG_TIMEOUT_SECONDS=60

# Request limits
MAX_UPLOAD_MB=100
MAX_FRAMES=300
MAX_FPS=60
DOWNLOAD_TIMEOUT_SECONDS=30

# Security
# Keep false in production to block SSRF against localhost / private networks
ALLOW_PRIVATE_URLS=false
CORS_ORIGINS=*

# Optional explicit path to ffmpeg binary (auto-detected if omitted)
# FFMPEG_PATH=/usr/bin/ffmpeg
